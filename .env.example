# Copy values into your shell environment. This file is not loaded automatically.
YC_AGENT_PROVIDER=deepseek
YC_AGENT_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=replace-with-your-personal-key
DEEPSEEK_THINKING=disabled
# Uncomment for python.org macOS Python when its default CA file is missing.
# SSL_CERT_FILE=/etc/ssl/cert.pem

# A locally deployed Qwen/vLLM server can use the generic compatible provider:
# YC_AGENT_PROVIDER=openai-compatible
# YC_AGENT_MODEL=your-qwen-model-name
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_API_KEY=local
